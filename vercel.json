{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/history/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/history/horse-date/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/suggestions/route.ts": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest-mark6",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/ingest-racing",
      "schedule": "0 7 * * 3,6"
    }
  ]
}
